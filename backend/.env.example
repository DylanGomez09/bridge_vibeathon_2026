# Clave de API de Google AI Studio (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Modelo de la Gemini Live API (ajustá si Google depreca el nombre)
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview

# Voz prebuilt del modelo de salida (Puck, Aoede, Charon, ...)
GEMINI_LIVE_VOICE=Aoede

# Puerto del backend Express + WebSocket
PORT=3001