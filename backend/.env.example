# Clave de API de Google AI Studio (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Modelo de la Gemini Live API (ajustá si Google depreca el nombre)
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview

# Voz prebuilt del modelo de salida (Puck, Aoede, Charon, ...)
GEMINI_LIVE_VOICE=Aoede

# Puerto del backend Express + WebSocket
PORT=3001

# Modalidad de la respuesta de Gemini Live.
# "audio" (funciona hoy) → el modelo habla la traducción y usamos outputAudioTranscription.
# "text" → subtítulos directos; dejar como fallback por si Google habilita TEXT en el modelo.
BRIDGE_RESPONSE_MODALITY=audio

# Idioma del audio de entrada (transcripción)
BRIDGE_SOURCE_LANG=en

# Idioma de la traducción
BRIDGE_TARGET_LANG=es

# Reintentos de reconexión con la Gemini Live API (antes de marcar la sesión como caída)
BRIDGE_RECONNECT_MAX_ATTEMPTS=3

# Delay base (ms) del backoff: intento 1 = base, intento 2 = base*2, intento 3 = base*4
BRIDGE_RECONNECT_BASE_DELAY_MS=1000

# Timeout (ms) para que Gemini confirme setupComplete al conectar/reconectar
BRIDGE_READY_TIMEOUT_MS=15000

# Watchdog (ms): si hay audio fluyendo y Gemini no manda ningún mensaje en este lapso, se reconecta.
# 0 desactiva el watchdog. (Los turnos tardan hasta ~33s; 60000 es seguro.)
BRIDGE_STALE_SESSION_MS=60000

# Tope de sesiones simultáneas. Cada sesión abierta consume una conexión a Gemini Live,
# así que este número limita el rate-limit. Al excederlo el cliente recibe un error claro.
BRIDGE_MAX_SESSIONS=4

# Grace period (ms) tras la desconexión del owner: la sesión queda abierta para que un
# refresh de pestaña no la corte. Si el owner no vuelve en este lapso, se cierra sola.
# 0 = cierre inmediato al desconectarse el owner.
BRIDGE_SESSION_GRACE_MS=15000

# --- Subtítulos de video (POST /api/video/subtitles) ---
# Modelo multimodal NO-Live. El de audio (GEMINI_LIVE_MODEL) no sirve acá porque
# generateContent con video requiere un modelo que no sea de la Live API.
# OJO: la disponibilidad de los modelos Flash cambia seguido. Con la key con la que se
# probó esto, gemini-3.8-flash daba 503 (UNAVAILABLE) sostenido y gemini-2.5-flash 404.
# El default es el Lite porque responde bien y acepta video; si se satura, probá otro
# de la lista de alternativas.
BRIDGE_VIDEO_MODEL=gemini-3.5-flash-lite
# Alternativas si el anterior está saturado (503) o sin cuota (429):
#   gemini-3.1-flash-lite, gemini-flash-latest, gemini-3.5-flash, gemini-3.8-flash

# Tope de duración del video en segundos (600 = 10 minutos). Más largo, el job se encarece
# y tarda mucho. Es un rechazo duro: el backend no procesa más que esto.
BRIDGE_VIDEO_MAX_SECONDS=600

# Tope de tamaño del archivo en bytes (209715200 = 200MB). Es el límite del body HTTP.
BRIDGE_VIDEO_MAX_BYTES=209715200

# Timeout (ms) del job completo: subida a la Files API + generateContent.
BRIDGE_VIDEO_TIMEOUT_MS=600000

# --- CORS ---
# Orígenes del frontend autorizados a llamar la API HTTP (el WebSocket no pasa por CORS).
# Separados por coma, sin espacios al final. Si Vite arranca en otro puerto, agregalo acá:
# si tu origen no está en la lista, el preflight falla y el browser bloquea la subida.
# No pongas "*": el endpoint no pide autenticación y consume cuota de Gemini.
BRIDGE_CORS_ORIGINS=http://localhost:5173,http://localhost:5174
